# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL="file:./db/custom.db"
# PostgreSQL example: DATABASE_URL="postgresql://user:password@host:5432/dbname"

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-random-64-char-string

# AI / LLM APIs
NEXT_PUBLIC_ZAI_API_KEY=
NEXT_PUBLIC_OPENROUTER_API_KEY=
OPENROUTER_API_KEY=

# Dev mode auth bypass (set to "true" only in local development)
ALLOW_DEV_AUTH_BYPASS=false

# Demo credentials (local dev only — never set in production)
NEXT_PUBLIC_DEMO_ADMIN_EMAIL=admin@almatech.com
NEXT_PUBLIC_DEMO_ADMIN_PASSWORD=admin123
NEXT_PUBLIC_DEMO_OPERATOR_EMAIL=operator@statoil.com
NEXT_PUBLIC_DEMO_OPERATOR_PASSWORD=operator123
NEXT_PUBLIC_DEMO_PARTNER_EMAIL=partner@oem.com
NEXT_PUBLIC_DEMO_PARTNER_PASSWORD=partner123